DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Local Docker Postgres alternative:
# DATABASE_URL="postgresql://webform:webform@localhost:5432/webform"
REDIS_URL="redis://localhost:6379"
PORT=3001
JWT_SECRET="change-me-to-a-long-random-secret"
DEMO_OWNER_EMAIL="owner@example.com"
DEMO_OWNER_PASSWORD="password123"
RATE_LIMIT_PER_MINUTE=60
# Optional: public web origin used in share/embed snippets (defaults to window.location.origin)
# VITE_PUBLIC_WEB_URL="https://your-app.vercel.app"

# Production: Render API origin (leave unset locally — Vite proxies /api → :3001)
# VITE_API_BASE_URL="https://webform-api.onrender.com"

# Hosted Redis for Render (Upstash TLS URL). Local Docker/Windows Redis for dev:
# REDIS_URL="rediss://default:PASSWORD@REGION.upstash.io:6379"

# AI form builder (OpenAI). Leave unset to disable /api/ai/forms.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# Supabase Auth (Google sign-in)
# 1) Supabase Dashboard → Authentication → Providers → enable Google
# 2) Add redirect URLs: http://localhost:5173/auth/callback and https://YOUR_VERCEL_DOMAIN/auth/callback
# 3) Paste project URL + anon key below (same values for API + Vite)
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"
# VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"

